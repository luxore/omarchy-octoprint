#!/usr/bin/env python3
"""Command boundary used by the Omarchy OctoPrint QML surface."""

from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys

sys.dont_write_bytecode = True

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from octoprint_companion.client import (  # noqa: E402
    ClientError,
    OctoPrintClient,
    SecretStore,
    authorize,
    canonical_url,
    configure,
    set_setting,
)


def print_json(value: object) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="octoprint-companion")
    result.add_argument("--url", required=True, help="OctoPrint base URL")
    subcommands = result.add_subparsers(dest="command", required=True)
    subcommands.add_parser("status")
    snapshot = subcommands.add_parser("snapshot")
    snapshot.add_argument("--path", default="/webcam/?action=snapshot")
    stream = subcommands.add_parser("stream")
    stream.add_argument("--path", default="/webcam/?action=stream")
    action = subcommands.add_parser("command")
    action.add_argument("action", choices=("pause", "resume", "cancel"))
    connect = subcommands.add_parser("authorize")
    connect.add_argument("--manual", action="store_true")
    connect.add_argument("--stdin", action="store_true", dest="from_stdin")
    configure_command = subcommands.add_parser("configure")
    configure_command.add_argument("--snapshot-path")
    configure_command.add_argument("--stream-path")
    configure_command.add_argument("--camera-mode", choices=("stream", "snapshots", "off"))
    configure_command.add_argument("--camera-enabled", choices=("true", "false"), help=argparse.SUPPRESS)
    configure_command.add_argument("--show-progress", choices=("true", "false"))
    configure_command.add_argument("--notify-finished", choices=("true", "false"))
    configure_command.add_argument("--notify-paused", choices=("true", "false"))
    configure_command.add_argument("--notify-error", choices=("true", "false"))
    setting = subcommands.add_parser("setting")
    setting.add_argument("key", choices=("cameraMode", "showProgress", "notifyFinished", "notifyPaused", "notifyError"))
    setting.add_argument("value")
    subcommands.add_parser("forget")
    subcommands.add_parser("open")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        server = canonical_url(args.url)
        if args.command == "authorize":
            if args.manual and args.from_stdin:
                raise ClientError("Choose either interactive or standard-input authorization")
            api_key = sys.stdin.readline() if args.from_stdin else None
            authorize(server, manual=args.manual, api_key=api_key)
            print_json({"ok": True})
            return 0
        if args.command == "configure":
            if args.camera_mode and args.camera_enabled:
                raise ClientError("Choose camera mode once")
            camera_mode = args.camera_mode
            if camera_mode is None and args.camera_enabled is not None:
                camera_mode = "snapshots" if args.camera_enabled != "false" else "off"
            values = {
                key: value
                for key, value in {
                    "cameraMode": camera_mode,
                    "showProgress": args.show_progress,
                    "notifyFinished": args.notify_finished,
                    "notifyPaused": args.notify_paused,
                    "notifyError": args.notify_error,
                }.items()
                if value is not None
            }
            server = configure(
                server,
                args.snapshot_path,
                args.stream_path,
                values,
            )
            print_json({"ok": True, "url": server})
            return 0
        if args.command == "setting":
            set_setting(args.key, args.value)
            print_json({"ok": True})
            return 0
        if args.command == "forget":
            SecretStore.clear(server)
            print_json({"ok": True})
            return 0
        if args.command == "open":
            subprocess.Popen(
                ["xdg-open", server],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            print_json({"ok": True})
            return 0

        key = SecretStore.lookup(server)
        if not key:
            print_json({"error": "Authorize this OctoPrint server to continue", "needsAuth": True})
            return 0 if args.command == "status" else 1
        client = OctoPrintClient(server, key)
        if args.command == "status":
            print_json(client.fetch_status())
        elif args.command == "snapshot":
            path = client.fetch_snapshot(args.path)
            print_json({"path": path.as_uri()})
        elif args.command == "stream":
            for path in client.stream_frames(args.path):
                print_json({"path": path.as_uri()})
                sys.stdout.flush()
        elif args.command == "command":
            client.command(args.action)
            print_json({"ok": True})
        return 0
    except BrokenPipeError:
        return 0
    except ClientError as error:
        print_json(
            {
                "error": str(error),
                "needsAuth": error.status == 403,
            }
        )
        return 0 if args.command == "status" else 1


if __name__ == "__main__":
    raise SystemExit(main())
