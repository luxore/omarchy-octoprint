{
  "schemaVersion": 1,
  "id": "io.github.luxore.octoprint",
  "name": "Omarchy OctoPrint",
  "version": "0.6.0",
  "author": "Luxore",
  "license": "MIT",
  "description": "An OctoPrint plugin for Omarchy.",
  "homepage": "https://github.com/luxore/omarchy-octoprint",
  "repository": "https://github.com/luxore/omarchy-octoprint",
  "keywords": [
    "octoprint",
    "3d-printing",
    "printer",
    "camera",
    "monitoring"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "OctoPrintWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy OctoPrint",
    "description": "Print progress and a camera-first attention view for one OctoPrint printer",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "instanceUrl": "http://octopi.local",
      "snapshotPath": "/webcam/?action=snapshot",
      "streamPath": "/webcam/?action=stream",
      "setupComplete": false,
      "cameraMode": "stream",
      "showProgress": true,
      "notifyFinished": true,
      "notifyPaused": true,
      "notifyError": true
    },
    "schema": [
      {
        "key": "instanceUrl",
        "type": "string",
        "label": "OctoPrint URL",
        "defaultValue": "http://octopi.local"
      },
      {
        "key": "snapshotPath",
        "type": "string",
        "label": "Webcam snapshot path",
        "defaultValue": "/webcam/?action=snapshot"
      },
      {
        "key": "streamPath",
        "type": "string",
        "label": "Webcam MJPEG stream path",
        "defaultValue": "/webcam/?action=stream"
      },
      {
        "key": "cameraMode",
        "type": "string",
        "label": "Camera mode",
        "defaultValue": "stream"
      },
      {
        "key": "showProgress",
        "type": "boolean",
        "label": "Show progress and ETA in the bar while printing",
        "defaultValue": true
      },
      {
        "key": "notifyFinished",
        "type": "boolean",
        "label": "Notify when a print finishes",
        "defaultValue": true
      },
      {
        "key": "notifyPaused",
        "type": "boolean",
        "label": "Notify when a print pauses",
        "defaultValue": true
      },
      {
        "key": "notifyError",
        "type": "boolean",
        "label": "Notify on printer errors",
        "defaultValue": true
      }
    ]
  }
}
